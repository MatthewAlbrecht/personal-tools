{
	"manifest_version": 3,
	"name": "RYM, Bandcamp, eBay & TCGplayer capture",
	"version": "0.11.0",
	"description": "Locally saves Rate Your Music release and charts metadata, captures Bandcamp albums to your library, and sends eBay search results and TCGplayer product pages to the Yu-Gi-Oh tracker, via a floating capture dock. Can also run the tracker's automated captures.",
	"permissions": ["storage", "alarms"],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"host_permissions": [
		"https://rateyourmusic.com/*",
		"https://*.bandcamp.com/*",
		"https://www.ebay.com/*",
		"https://www.tcgplayer.com/*",
		"https://www.moooose.dev/*",
		"http://127.0.0.1:1333/*",
		"http://localhost:1333/*"
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "service-worker.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://rateyourmusic.com/release/album/*",
				"https://rateyourmusic.com/release/ep/*",
				"https://rateyourmusic.com/release/mixtape/*",
				"https://rateyourmusic.com/release/comp/*",
				"https://rateyourmusic.com/release/additional/*",
				"https://www.rateyourmusic.com/release/album/*",
				"https://www.rateyourmusic.com/release/ep/*",
				"https://www.rateyourmusic.com/release/mixtape/*",
				"https://www.rateyourmusic.com/release/comp/*",
				"https://www.rateyourmusic.com/release/additional/*"
			],
			"js": ["scrape-dock.js", "content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://rateyourmusic.com/charts/*",
				"https://www.rateyourmusic.com/charts/*"
			],
			"js": ["scrape-dock.js", "charts-content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://*.bandcamp.com/album/*"],
			"js": ["bandcamp-content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://www.ebay.com/sch/*"],
			"js": [
				"scrape-dock.js",
				"marketplaces.js",
				"run-navigation.js",
				"page-scroll.js",
				"ebay-reader.js",
				"ebay-content.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://www.tcgplayer.com/product/*"],
			"js": [
				"scrape-dock.js",
				"marketplaces.js",
				"run-navigation.js",
				"page-scroll.js",
				"tcgplayer-reader.js",
				"tcgplayer-content.js"
			],
			"run_at": "document_idle"
		}
	]
}
